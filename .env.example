# ==========================================
# LG전자 산학협력 프로젝트 환경 변수
# 🚨 경고: 실제 키가 들어간 .env 파일은 절대 Git에 커밋하지 마세요!
# ==========================================

# 1. OpenAI API 키 (GPT-4o 등 멀티모달, 텍스트 정제용)
# 발급처: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-여기에_실제_오픈에이아이_키를_붙여넣으세요"

# 2. Anthropic API 키 (Claude 3.5 Sonnet 등 텍스트/표 변환용)
# 발급처: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-여기에_실제_클로드_키를_붙여넣으세요"

# 3. (선택) Hugging Face 토큰 
# Marker나 LayoutLM 같은 오픈소스 Vision 모델 중 권한이 필요한 모델을 다운로드할 때 쓰일 수 있음
# 발급처: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN="hf_여기에_허깅페이스_토큰을_붙여넣으세요"

# 4. (선택) 시스템 및 디버그 설정
# 앱 개발 중 오류 메시지를 더 자세히 보고 싶을 때 사용
DEBUG_MODE="True"

# 5. 표 추출 실행 모드
# direct: 파이프라인 프로세스에서 직접 실행, TextExtractor와 SharedOCR을 재사용함
# worker: 표 추출을 별도 프로세스로 실행, 크래시 격리에 유리함
TABLE_EXTRACTION_MODE="direct"
TABLE_EXTRACTION_ENABLED="true"
TABLE_EXTRACTION_WORKER_TIMEOUT_SECONDS="300"

# Fast table fallback smoke test:
# TABLE_EXTRACTION_ENABLED="false"

# Faster worker-mode failure test:
# TABLE_EXTRACTION_MODE="worker"
# TABLE_EXTRACTION_WORKER_TIMEOUT_SECONDS="30"

# 6. 로컬 오픈웨이트 LLM 후처리 설정
# mode:
#   baseline = LLM 후처리 없음
#   semantic = 제목/캡션 후보 보정만 실행
#   content  = 문단/리스트/제목 텍스트 띄어쓰기 보정만 실행
#   all      = semantic + content 모두 실행
LLM_ENRICHMENT_MODE="semantic"

# backend:
#   transformers = 가정용 데스크탑 GPU 권장 기본값
#   ollama       = 노트북/저사양 로컬 테스트용. 자세한 설명은 아래 참고 섹션 참조
LOCAL_LLM_BACKEND="transformers"

# semantic 설정입니다. LLM_ENRICHMENT_MODE="semantic" 또는 "all"일 때 사용됩니다.
LOCAL_LLM_SEMANTIC_MODEL_ID="Qwen/Qwen3-0.6B"
LLM_SEMANTIC_MAX_NEW_TOKENS="128"
# 가정용 데스크탑 GPU에서는 8부터 시작하고, OOM이 나면 4 -> 1 순서로 낮춥니다.
# GPU vram이 충분할 때는 8 -> 16 -> 32 -> ... 순서로 늘리면 속도를 높일 수 있습니다.
LLM_SEMANTIC_BATCH_SIZE="8"

# content 설정입니다. LLM_ENRICHMENT_MODE="content" 또는 "all"일 때 사용됩니다.
LOCAL_LLM_CONTENT_MODEL_ID="Qwen/Qwen3-0.6B"
LLM_CONTENT_MAX_NEW_TOKENS="256"
# 가정용 데스크탑 GPU에서 transformers backend로 돌릴 때는 8부터 시작합니다.
# Ollama + 소형 GGUF 모델은 한 번에 많은 항목을 주면 원문 그대로 반환하는 비율이 커질 수 있으므로 1~2를 권장합니다.
LLM_CONTENT_BATCH_SIZE="1"
LLM_CONTENT_MIN_CHARS="20"

# 공통 생성 설정입니다.
LLM_REQUEST_TIMEOUT_SECONDS="60"

# 생성 진행 상황 로그 간격입니다. 0이면 끄고, 16이면 16 token 단위로 로그를 남깁니다.
LLM_PROGRESS_LOG_INTERVAL="16"

# ------------------------------------------------------------
# 참고: 노트북/저사양 로컬에서 Ollama로 semantic만 테스트하고 싶을 때
# ------------------------------------------------------------
# LLM_ENRICHMENT_MODE="semantic"
# LOCAL_LLM_BACKEND="ollama"
# LOCAL_LLM_SEMANTIC_MODEL_ID="hf.co/ggml-org/Qwen3-0.6B-GGUF:Q4_0"
# LLM_SEMANTIC_MAX_NEW_TOKENS="128"
# LLM_SEMANTIC_BATCH_SIZE="32"
# # content/all 모드까지 Ollama로 테스트할 때는 LLM_ENRICHMENT_MODE를 "content" 또는 "all"로 바꾸고 아래처럼 작게 시작합니다.
# # batch를 16처럼 크게 잡으면 JSON은 맞아도 대부분 unchanged가 될 수 있습니다.
# LOCAL_LLM_CONTENT_MODEL_ID="hf.co/ggml-org/Qwen3-0.6B-GGUF:Q4_0"
# LLM_CONTENT_MAX_NEW_TOKENS="256"
# LLM_REQUEST_TIMEOUT_SECONDS="60"
# LLM_CONTENT_BATCH_SIZE="1"
#
# 2GB VRAM 노트북에서는 transformers 설정이 OOM이 날 수 있으므로 위 Ollama 설정을 권장합니다.
# 후보가 30개 안팎이면 32로 한 번에 처리하고, 응답 JSON이 흔들리면 16 -> 8 -> 4 순서로 낮춥니다.

# ------------------------------------------------------------
# 참고: 노트북/리눅스 Ollama 설치 및 세부 설정
# ------------------------------------------------------------
# 노트북/2GB VRAM 테스트에서는 Ollama + GGUF 양자화 모델을 권장합니다.
# transformers로 Qwen/Qwen3-0.6B를 직접 올리면 모델 크기는 작아 보여도
# PyTorch 모델 로딩, KV cache, 긴 semantic 입력 prompt 때문에
# batch_size=1이어도 CUDA OOM이 날 수 있습니다.
#
# Ollama 경로는 외부 OpenAI API가 아니라 내 PC의 로컬 서버
# http://127.0.0.1:11434 를 호출합니다.
#
# Windows PowerShell 설치:
#   irm https://ollama.com/install.ps1 | iex
#
# Linux 설치:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama --version
#   sudo systemctl start ollama
#   sudo systemctl status ollama
#
# 설치 후 새 PowerShell에서 서버/모델 준비:
#   ollama --version
#   ollama pull hf.co/ggml-org/Qwen3-0.6B-GGUF:Q4_0
#   ollama run hf.co/ggml-org/Qwen3-0.6B-GGUF:Q4_0
#
# 서버 확인:
#   브라우저 또는 PowerShell에서 http://127.0.0.1:11434/api/tags 가 응답하면 정상입니다.
#
# LOCAL_LLM_SEMANTIC_MODEL_ID / LOCAL_LLM_CONTENT_MODEL_ID:
#   Ollama에서 Hugging Face GGUF 모델을 직접 사용할 때는 hf.co/... 형식을 씁니다.
#
# 기본 Ollama 로컬 서버를 쓰면 아래 값은 따로 설정하지 않아도 됩니다.
# 다른 로컬 Ollama 주소를 써야 할 때만 주석을 해제합니다.
# LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
# LOCAL_LLM_API_KEY="ollama"
